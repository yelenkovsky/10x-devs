---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { DEFAULT_RETURN_PATH, authPageQuery, safeReturnPath } from "@/lib/auth";

if (Astro.locals.user) {
  return Astro.redirect(safeReturnPath(Astro.url.searchParams.get("next"), Astro.url));
}

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice");
const next = safeReturnPath(Astro.url.searchParams.get("next"), Astro.url);
const nextField = next === DEFAULT_RETURN_PATH ? undefined : next;
const signupHref = `/auth/signup${authPageQuery({ next })}`;
---

<Layout title="Sign in">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Sign in
      </h1>
      {
        notice && (
          <p
            class="mb-4 rounded-lg border border-white/15 bg-white/10 px-3 py-2 text-sm text-blue-100/80"
            role="status"
          >
            {notice}
          </p>
        )
      }
      <SignInForm serverError={error} next={nextField ?? null} />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Don't have an account?{" "}
        <a href={signupHref} class="text-purple-300 hover:underline">Sign up</a>
      </p>
    </div>
  </div>
</Layout>
