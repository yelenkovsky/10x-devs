---
import ReviewSession from "@/components/cards/ReviewSession";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { getReviewSession } from "@/lib/services/review-session";
import { createClient } from "@/lib/supabase";
import type { ReviewSessionPayload } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const emptySession: ReviewSessionPayload = { card: null, remaining: 0, emptyReason: "no_kept" };
let initialSession = emptySession;
let loadError = !supabase || !user;
if (supabase && user) {
  try {
    initialSession = await getReviewSession({
      userId: user.id,
      supabase,
      now: new Date(),
    });
  } catch {
    loadError = true;
  }
}
---

<Layout title="Review">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <Topbar />
    <div class="mx-auto flex max-w-3xl flex-col gap-6">
      <header class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Review
        </h1>
      </header>
      <ReviewSession initialSession={initialSession} loadError={loadError} client:load />
    </div>
  </div>
</Layout>
