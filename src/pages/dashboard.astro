---
import PasteGenerate from "@/components/cards/PasteGenerate";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { listFlashcards } from "@/lib/services/list-flashcards";
import { loadOpenRouterKeyHint } from "@/lib/services/openrouter-key";
import { createClient } from "@/lib/supabase";
import type { Flashcard } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
let cards: Flashcard[] = [];
let configured = false;
let loadError = !supabase;
if (supabase) {
  try {
    cards = await listFlashcards(supabase);
  } catch {
    loadError = true;
  }
  try {
    const keyStatus = await loadOpenRouterKeyHint(supabase);
    configured = keyStatus.configured;
  } catch {
    configured = false;
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <Topbar />
    <div class="mx-auto flex max-w-3xl flex-col gap-6">
      <header class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Dashboard
        </h1>
      </header>
      <PasteGenerate initialCards={cards} loadError={loadError} configured={configured} client:load />
    </div>
  </div>
</Layout>
