---
import { cn } from "@/lib/utils";

const { user } = Astro.locals;
const pathname = Astro.url.pathname;

const productLinks = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/cards", label: "Cards" },
  { href: "/review", label: "Review" },
] as const;
---

<div
  class="mb-4 flex flex-wrap items-center justify-between gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <nav aria-label="Product" class="flex flex-wrap items-center gap-3">
          {productLinks.map((link) => {
            const isCurrent = pathname === link.href;
            return (
              <a
                href={link.href}
                aria-current={isCurrent ? "page" : undefined}
                class:list={[
                  cn(
                    "text-purple-300 transition-colors hover:text-purple-100 hover:underline",
                    isCurrent && "font-medium text-purple-100 underline",
                  ),
                ]}
              >
                {link.label}
              </a>
            );
          })}
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Sign out
            </button>
          </form>
        </nav>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
