# User or service-account key from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=crsr_...
# Optional; defaults to composer-2.5
CURSOR_MODEL=composer-2.5

# OpenRouter key for `npm run eval` and the GitHub Actions review job
OPENROUTER_API_KEY=sk-or-v1-...
# Optional; defaults to openai/gpt-4.1-mini
OPENROUTER_MODEL=openai/gpt-4.1-mini
